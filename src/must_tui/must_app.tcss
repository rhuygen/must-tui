LoadingScreen {
    align: center middle;
}

#loading-dialog {
    border: thick $primary 50%;
    background: $boost;
    width: 50%;
    height: 11;
    padding: 1 2;
    align: center middle;
    content-align: center middle;
}

#loading-title {
    text-style: bold;
    content-align: center middle;
    width: 1fr;
    margin-bottom: 1;
}

#loading-status {
    content-align: center middle;
    width: 1fr;
    margin-bottom: 1;
}

#loading-subtitle {
    color: $text-muted;
    content-align: center middle;
    width: 1fr;
}

OptionList {
/*  border: solid green; */
    width: 20%;
    height: 1fr;
}

#input-container {
/*    border: solid red; */
    height: 3;
}

#main-container {
/*  border: solid red; */
    width: auto;
    height: 1fr;
}

#info-container {
/*    border: solid red; */
    width: 1fr;
    height: 1fr;
}

#plot-controls {
/*    border: solid red; */
    height: 3;
}

#status-bar {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* Textual's default Button style reverses the label text on focus (which a click leaves behind); show the
   already-present subtle background tint instead of reversing the text. */
#plot-controls Button:focus {
    text-style: bold;
}

#bt-plot-clear {
/*    border: solid red; */
}

/* "z" toggles this: hide everything except the plot and its controls, which then fill the screen. */
MainScreen.-plot-maximized Header,
MainScreen.-plot-maximized Footer,
MainScreen.-plot-maximized #input-container,
MainScreen.-plot-maximized OptionList,
MainScreen.-plot-maximized #info-container,
MainScreen.-plot-maximized #status-bar {
    display: none;
}

DataTable {
/*  border: round red; */
    width: 100%;
    height: auto;
}

ParameterInfo {
/*  border: heavy white; */
    height: 1fr;
    width: 50%;
}

ParameterMetadata {
/*  border: heavy white; */
    height: 1fr;
    width: 50%;
}

PlotWidget {
/*    border: solid blue; */
    height: 1fr;
}

/* The same focus border as the option list (Textual's OptionList default): dim when blurred, so the layout doesn't
   shift, and highlighted while the plot has focus, i.e. while its pan/zoom keys work. */
TimeRangePlotter {
    border: tall $border-blurred;
}

TimeRangePlotter:focus {
    border: tall $border;
}

#input-search {
/*    border: solid white; */
    height: 3;
    width: 1fr;
}

#regex-checkbox {
/*    border: solid white; */
    width: 15;
    height: 3;
}

ErrorDialog {
    align: center middle;
}

ErrorDialog > Vertical {
    border: thick $primary 50%;
    width: 50%;
    height: 16;
    background: $boost;
    Label {
        text-style: bold;
        margin: 2 4;
    }
    Button {
        margin: 0 2;
    }
    Horizontal {
        width: 100%;
        align: center top;
        #btn-dialog-yes {
            margin-right: 2;
        }
    }
}


WarningDialog {
    align: center middle;
}

WarningDialog > Vertical {
    border: thick $primary 50%;
    width: 50%;
    height: 16;
    background: $boost;
    Label {
        text-style: bold;
        margin: 2 4;
    }
    Button {
        margin: 0 2;
    }
    Horizontal {
        width: 100%;
        align: center top;
        #btn-dialog-yes {
            margin-right: 2;
        }
    }
}

HelpDialog {
    align: center middle;
}

HelpDialog > Vertical {
    border: thick $primary 50%;
    width: 80%;
    height: 80%;
    background: $boost;
    padding: 1 2;

    VerticalScroll {
        height: 1fr;
    }

    #btn-dialog-close {
        width: 100%;
        margin-top: 1;
    }
}

YAxisRangeDialog {
    align: center middle;
}

YAxisRangeDialog > Vertical {
    border: thick $primary 50%;
    width: 70%;
    min-width: 66;
    height: auto;
    background: $boost;
    padding: 1 2;

    Label {
        text-style: bold;
        margin-bottom: 1;
    }

    Horizontal {
        height: 3;
        align: left middle;

        Label {
            width: 6;
            text-style: none;
            margin-bottom: 0;
        }

        Input {
            width: 1fr;
        }
    }

    #lbl-y-range-error {
        color: $error;
        text-style: none;
        height: 1;
    }

    Horizontal:last-of-type {
        height: 3;
        align: center middle;
        Button {
            margin: 0 1;
        }
    }
}

TimeRangeDialog {
    align: center middle;
}

TimeRangeDialog > Vertical {
    border: thick $primary 50%;
    /* Just wide enough for one option line (22-column name + "start → end", 63 columns) not to wrap, even with
       the list's vertical scrollbar shown (short terminals); hence also the narrow horizontal padding. */
    width: 74;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    background: $boost;
    padding: 1 1;

    Label {
        text-style: bold;
        margin-bottom: 1;
    }

    #lbl-time-range-current {
        text-style: none;
    }

    /* 1fr + the box's max-height: the list shrinks (and scrolls) in a short terminal, keeping Cancel visible. */
    OptionList {
        width: 100%;
        height: 1fr;
        max-height: 32;
    }

    Horizontal {
        height: 3;
        margin-top: 1;
        align: center middle;
    }
}
